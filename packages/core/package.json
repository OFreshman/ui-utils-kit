{
  "name": "ui-utils-kit",
  "type": "module",
  "version": "1.3.14",
  "description": "ui-utils-kit 是一个高效的偏业务前端工具函数库",
  "author": "Ethan Yin",
  "license": "MIT",
  "homepage": "https://github.com/OFreshman/ui-utils-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OFreshman/ui-utils-kit.git"
  },
  "bugs": "https://github.com/OFreshman/ui-utils-kit/issues",
  "keywords": [
    "js",
    "web",
    "tool",
    "utils"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.mjs",
      "require": "./dist/common.cjs"
    },
    "./tree": {
      "types": "./dist/tree-operations.d.ts",
      "import": "./dist/tree-operations.mjs",
      "require": "./dist/tree-operations.cjs"
    },
    "./business": {
      "types": "./dist/business.d.ts",
      "import": "./dist/business.mjs",
      "require": "./dist/business.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "common": [
        "./dist/common.d.ts"
      ],
      "tree": [
        "./dist/tree-operations.d.ts"
      ],
      "business": [
        "./dist/business.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild"
  },
  "peerDependencies": {
    "html2canvas-pro": "^1"
  },
  "peerDependenciesMeta": {
    "html2canvas-pro": {
      "optional": true
    }
  },
  "devDependencies": {
    "html2canvas-pro": "catalog:",
    "unbuild": "catalog:"
  }
}