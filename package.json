{
  "name": "ui-utils-kit",
  "type": "module",
  "version": "1.3.14",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "description": "ui-utils-kit 是一个偏业务的前端工具函数库",
  "author": "OFreshman",
  "homepage": "https://ofreshman.github.io/ui-utils-kit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OFreshman/ui-utils-kit"
  },
  "bugs": {
    "url": "https://github.com/OFreshman/ui-utils-kit/issues"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "play": "pnpm --dir playground dev",
    "build": "pnpm --recursive --filter=\"./packages/*\" build",
    "release": "bumpp -r",
    "lint": "eslint --cache .",
    "lint:type": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "pnpm lint --fix",
    "stylelint:fix": "stylelint **/*.{css,scss,html,vue} --fix",
    "test:run": "vitest run",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check && node scripts/check-docs.mjs",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-package.mjs --release",
    "check": "pnpm lint && pnpm lint:type && pnpm test:run && pnpm build && pnpm docs:check && pnpm docs:build && pnpm package:check",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview"
  },
  "devDependencies": {
    "@xiaohe01/eslint-config": "catalog:",
    "@xiaohe01/tsconfig": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": "eslint --fix"
  }
}